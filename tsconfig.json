{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noUnusedLocals": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@app/*": ["./vendor/loan-app/src/*"], "@tokens/*": ["./vendor/tokens/*"], "react": ["./node_modules/@types/react"], "react/*": ["./node_modules/@types/react/*"] }
  },
  "include": ["src"]
}
